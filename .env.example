# ============================================================================
# AUTORECIBOS AI - VARIABLES DE ENTORNO (.env)
# ============================================================================

# Puerto para el Panel Web Administrativo
PORT=3080

# 1. Inteligencia Artificial Multimodal (Google AI Studio - Gratis)
# Usa el modelo gemini-3.8-flash para extraer datos de PDFs, fotos y correos
GEMINI_API_KEY=

# 2. Lectura Automática de Correo (IMAP Gmail / Outlook)
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# 3. Motor de Envío a WhatsApp (baileys | green-api | callmebot | webhook)
WHATSAPP_PROVIDER=baileys

# Sesión exportada en Base64 para ejecución en la nube (GitHub Actions)
# Puedes generarla desde el Panel Web o ejecutando: npm run whatsapp:qr
WHATSAPP_SESSION_BASE64=

# Opcional: Green-API (Plan Developer Gratis en green-api.com)
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Opcional: CallMeBot (API Gratuita)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Opcional: URL CSV publicada de Google Sheets para sincronizar porcentajes
GOOGLE_SHEETS_CSV_URL=
